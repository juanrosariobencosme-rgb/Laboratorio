{
  "name": "laboratorio-transformaciones-geometricas",
  "version": "1.0.0",
  "private": true,
  "description": "Laboratorio web interactivo para transformaciones geométricas en 2D.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:css && npm run copy:assets",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/css/app.css --minify",
    "copy:assets": "node scripts/copy-assets.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "express": "5.1.0",
    "helmet": "8.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "tailwindcss": "4.3.0"
  }
}
